BACKEND_APP_NAME=TikTok Shop Product Video Backend
BACKEND_ENVIRONMENT=phase2b-local
BACKEND_API_KEY=replace-with-local-phase2b-api-key
BACKEND_OWNER_ID=owner_phase2b_local
BACKEND_DATABASE_URL=sqlite:////data/database/backend.db
BACKEND_PUBLIC_BASE_URL=http://127.0.0.1:8000
BACKEND_IDEMPOTENCY_COMPLETED_TTL_HOURS=24
BACKEND_IDEMPOTENCY_PENDING_LEASE_SECONDS=60
BACKEND_MOCK_STORAGE_DIRECTORY=/data/mock_storage
BACKEND_MOCK_UPLOAD_TOKEN_TTL_HOURS=24
BACKEND_RESULT_TOKEN_SECRET=replace-with-different-result-token-secret-32chars-min
BACKEND_RESULT_TOKEN_TTL_HOURS=24
BACKEND_MAX_ASSET_SIZE_BYTES=104857600
BACKEND_UPLOAD_TOKEN_BYTES=32
